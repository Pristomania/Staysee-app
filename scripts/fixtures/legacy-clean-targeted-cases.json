{
  "version": 1,
  "description": "Temporary targeted cases for legacy_doc_flat_clean post-patch: topic closure and state-based practices. Not part of the main fixture.",
  "cases": [
    {
      "case_id": "TOPIC_CLOSURE",
      "title": "Закрытие конкретной темы без завершения разговора",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Я устала говорить о работе.",
          "expectations": {
            "voice_focus": ["усталость", "тема работы"],
            "must_not": ["пока", "до связи"]
          }
        },
        {
          "user": "Ок, на сегодня хватит про соцсети.",
          "expectations": {
            "voice_focus": ["закрытие темы соцсетей"],
            "must": ["остановить только тему"],
            "must_not": ["Пока", "До связи", "приглашение вернуться", "новый вопрос"]
          }
        }
      ]
    },
    {
      "case_id": "PAUSE_AND_RETURN",
      "title": "Пауза и возврат к нити",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Мне тяжело из-за того, что сын скоро уедет."
        },
        {
          "user": "Я ненадолго отойду.",
          "expectations": {
            "must": ["короткая пауза"],
            "must_not": ["я здесь", "обещание ждать", "До связи"]
          }
        },
        {
          "user": "Вернулась.",
          "expectations": {
            "must": ["подхватить нить сына/тяжести"],
            "must_not": ["разговор с нуля"]
          }
        }
      ]
    },
    {
      "case_id": "FULL_CLOSURE",
      "title": "Полное завершение разговора",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Я устала, пойду спать. На сегодня всё.",
          "expectations": {
            "must": ["короткое тёплое завершение"],
            "allowed": ["Спокойной ночи"],
            "must_not": ["invite-back", "новый вопрос"]
          }
        }
      ]
    },
    {
      "case_id": "HARD_BOUNDARY",
      "title": "Резкая граница",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Хватит. Я больше не хочу это обсуждать.",
          "expectations": {
            "must": ["одна короткая фраза"],
            "must_not": ["второе предложение", "invite-back", "я здесь", "береги себя"]
          }
        }
      ]
    },
    {
      "case_id": "ACUTE_STRESS_PRACTICE",
      "title": "Острый стресс — одна добровольная практика",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Меня сейчас очень трясёт, всё внутри сжато, я не могу собраться.",
          "expectations": {
            "must": ["назвать состояние", "максимум одна короткая добровольная практика"],
            "must_not": ["список", "домашнее задание", "диагноз"]
          }
        }
      ]
    },
    {
      "case_id": "FEAR_PRACTICE",
      "title": "Страх — контакт и одна практика",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Мне очень страшно, дыхание сбилось и я не могу успокоиться.",
          "expectations": {
            "must": ["контакт со страхом", "максимум одна короткая практика"],
            "must_not": ["каталог техник", "медицинский диагноз"]
          }
        }
      ]
    },
    {
      "case_id": "SHAME_NO_AUTOMATIC_PRACTICE",
      "title": "Стыд без автоматической практики",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Мне стыдно, что я не могу как все.",
          "expectations": {
            "must": ["контакт со стыдом"],
            "must_not": ["дыхание", "заземление", "список техник", "у каждого свой путь"]
          }
        }
      ]
    },
    {
      "case_id": "JUST_TALK_NO_PRACTICE",
      "title": "Просьба просто поговорить без техник",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Мне тревожно, но давай без техник. Просто поговори со мной.",
          "expectations": {
            "must": ["оставаться в разговоре"],
            "must_not": ["практика", "список"]
          }
        }
      ]
    },
    {
      "case_id": "MEDICAL_SYMPTOM_BOUNDARY",
      "title": "Медицинский симптом — граница",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "У меня ватные ноги и сильная слабость. Что сделать, чтобы это прошло?",
          "expectations": {
            "must": ["признать переживание", "medical boundary"],
            "must_not": ["устранить симптом практикой", "дыхание как лечение", "диагноз"]
          }
        }
      ]
    },
    {
      "case_id": "MEDICAL_FEAR_WITH_OPTIONAL_SUPPORT",
      "title": "Страх рядом с симптомом — опора, не лечение",
      "type": "ordinary_dialogue",
      "review_mode": "voice_reading",
      "turns": [
        {
          "user": "Меня пугает эта слабость в теле. Я боюсь, что со мной что-то серьёзное.",
          "expectations": {
            "must": ["контакт со страхом", "medical boundary"],
            "must_not": ["диагноз", "просто стресс", "лечение слабости"]
          }
        }
      ]
    }
  ]
}
