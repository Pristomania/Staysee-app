            "voice_focus": ["пустота", "слово 'заставить'", "не давить"],
            "must": ["не цепляется за слово 'заставить' буквально", "держит пустоту"],
            "must_not": ["длинный список мотивации", "план дисциплины"]
          }
        },
        {
          "user": "Блин, не хочу.",
          "expectations": {
            "voice_focus": ["сопротивление", "живое нежелание"],
            "must": ["слышит сопротивление", "не давит"],
