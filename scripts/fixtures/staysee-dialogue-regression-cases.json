            "voice_focus": ["стыд", "сравнение с другими"],
            "must": ["держит стыд", "не спорит с чувством напрямую"],
            "must_not": ["банальное 'не сравнивай себя'", "быстрый позитив"]
          }
        },
        {
          "user": "Получилось то, что я уже пишу тебе в приложении.",
          "expectations": {
            "voice_focus": ["заметить реальное действие", "вернуть авторство человеку"],
            "must": ["замечает реальное достижение", "возвращает авторство человеку"],
            "must_not": ["присваивает результат себе", "слишком восторженная похвала"]
